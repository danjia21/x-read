{
  "manifest_version": 3,
  "name": "x-read Notes",
  "version": "0.2.0",
  "description": "Show x-read notes on the original article with publisher-site access.",
  "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"},
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Show x-read notes", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}},
  "content_scripts": [{
    "matches": ["https://read.danjia.me/*", "http://127.0.0.1/*", "http://localhost/*"],
    "js": ["bridge.js"]
  }]
}
