{
  "manifest_version": 3,
  "name": "x-read Notes",
  "version": "0.2.0",
  "description": "Show x-read notes on the original article with publisher-site access.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Show x-read notes"},
  "content_scripts": [{
    "matches": ["https://read.danjia.me/*", "http://127.0.0.1/*", "http://localhost/*"],
    "js": ["bridge.js"]
  }]
}
