SITE_DOMAIN=read.example.com
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# GitHub App: install only on this repository, Contents: read-only.
GITHUB_CLIENT_ID=
# Numeric GitHub user ID, not the username.
GITHUB_ALLOWED_USER_ID=
GITHUB_CLIENT_SECRET_FILE_HOST=./secrets/github-client-secret
CACHE_TTL_SECONDS=300
